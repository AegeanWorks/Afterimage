{
  "schema": 1,
  "surfaces": {
    "app": {
      "paths": [
        "index.html",
        "game.js"
      ]
    }
  },
  "protected": [
    "tests/**"
  ],
  "commands": {
    "fast": "node --test tests",
    "snapshot": ""
  },
  "style": {
    "theme_paths": []
